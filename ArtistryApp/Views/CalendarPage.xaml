<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArtistryApp.Views.CalendarPage"
             Title="CalendarPage">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="20">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="10"
                             Margin="0,15,0,20">

            <Label Text="My Calendar"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#33215E"/>

            <Label Text="Manage your creative classes"
                   FontSize="14"
                   TextColor="#888888"/>

            <!-- Add Session Button -->
            <Button x:Name="AddSessionButton"
                    Text="+ Add New Session"
                    BackgroundColor="#7045C5"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="45"
                    Clicked="AddSession_Clicked"/>

        </VerticalStackLayout>

        <!-- Loading -->
        <ActivityIndicator
            x:Name="LoadingIndicator"
            Grid.Row="1"
            IsRunning="False"
            IsVisible="False"
            Color="#7045C5"
            HorizontalOptions="Center"/>

        <!-- Main Content -->
        <Grid Grid.Row="2">

            <!-- Calendar Collection -->
            <CollectionView
                x:Name="CalendarCollection"
                SelectionMode="Single"
                SelectionChanged="OnClassSelected">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            BackgroundColor="White"
                            Stroke="#EAE5F2"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="0,5"
                            StrokeShape="RoundRectangle 14">

                            <VerticalStackLayout Spacing="10">

                                <Label
                                    Text="{Binding ClassName}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#33215E"/>

                                <Label
                                    Text="{Binding Description}"
                                    FontSize="13"
                                    TextColor="#888888"/>

                                <HorizontalStackLayout Spacing="5">

                                    <Label Text="Teacher:"
                                           FontSize="13"
                                           TextColor="#999999"/>

                                    <Label
                                        Text="{Binding TeacherName}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#555555"/>

                                </HorizontalStackLayout>

                                <BoxView HeightRequest="1"
                                         BackgroundColor="#F0EDF5"/>

                                <Grid ColumnDefinitions="*,Auto">

                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="4">

                                        <Label Text="DATE"
                                               FontSize="10"
                                               TextColor="#AAAAAA"/>

                                        <Label
                                            Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="#7045C5"/>

                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="4"
                                                         HorizontalOptions="End">

                                        <Label Text="TIME"
                                               FontSize="10"
                                               TextColor="#AAAAAA"
                                               HorizontalTextAlignment="End"/>

                                        <Label
                                            Text="{Binding StartTime}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="#7045C5"/>

                                        <Label
                                            Text="{Binding EndTime}"
                                            FontSize="12"
                                            TextColor="#888888"/>

                                    </VerticalStackLayout>

                                </Grid>

                                <Label Text="VIEW STUDENTS →"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#7045C5"
                                       HorizontalOptions="End"/>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- Empty State -->
            <VerticalStackLayout
                x:Name="EmptyContainer"
                IsVisible="False"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="10">

                <Label Text="🎨"
                       FontSize="40"
                       HorizontalOptions="Center"/>

                <Label Text="No classes scheduled"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#33215E"
                       HorizontalOptions="Center"/>

            </VerticalStackLayout>

            <!-- Add Session Form -->
            <ScrollView
                x:Name="AddSessionForm"
                IsVisible="False">

                <VerticalStackLayout
                    Padding="15"
                    Spacing="12">

                    <Label Text="Create New Session"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#33215E"/>

                    <Label Text="Session Name"
                           FontAttributes="Bold"
                           FontSize="13"/>

                    <Entry x:Name="SessionNameEntry"
                           Placeholder="Enter session name"
                           BackgroundColor="#F7F5FA"/>

                    <Label Text="Description"
                           FontAttributes="Bold"
                           FontSize="13"/>

                    <Editor x:Name="SessionDescriptionEditor"
                            Placeholder="Enter session description"
                            HeightRequest="90"
                            BackgroundColor="#F7F5FA"/>

                    <Label Text="Select Teacher"
                           FontAttributes="Bold"
                           FontSize="13"/>

                    <Picker x:Name="TeacherPicker"
                            Title="Select Teacher"
                            ItemDisplayBinding="{Binding TeacherName}"
                            BackgroundColor="#F7F5FA"/>

                    <Label Text="Session Date"
                           FontAttributes="Bold"
                           FontSize="13"/>

                    <DatePicker x:Name="SessionDatePicker"
                                BackgroundColor="#F7F5FA"/>

                    <Label Text="Start Time"
                           FontAttributes="Bold"
                           FontSize="13"/>

                    <TimePicker x:Name="SessionStartTimePicker"
                                BackgroundColor="#F7F5FA"/>

                    <Label Text="End Time"
                           FontAttributes="Bold"
                           FontSize="13"/>

                    <TimePicker x:Name="SessionEndTimePicker"
                                BackgroundColor="#F7F5FA"/>

                    <Button x:Name="SaveSessionButton"
                            Text="Save Session"
                            BackgroundColor="#7045C5"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="48"
                            Clicked="SaveSession_Clicked"/>

                    <Button Text="Cancel"
                            BackgroundColor="#EAE5F2"
                            TextColor="#33215E"
                            CornerRadius="10"
                            HeightRequest="45"
                            Clicked="CancelSession_Clicked"/>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
