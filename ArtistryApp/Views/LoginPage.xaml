<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ArtClass.Mobile.Views.LoginPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8F7FC">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,60,30,30"
            Spacing="20"
            VerticalOptions="Center">

            <!-- Application Logo -->
            <VerticalStackLayout
                Spacing="8"
                HorizontalOptions="Center">

                <Border
                    WidthRequest="85"
                    HeightRequest="85"
                    StrokeThickness="0"
                    BackgroundColor="#EEE7FF"
                    StrokeShape="RoundRectangle 22">

                    <Label
                        Text="🎨"
                        FontSize="42"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                </Border>

                <Label
                    Text="ArtClass"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#33215E"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Your creative classroom companion"
                    FontSize="13"
                    TextColor="#888888"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Label
                Text="Welcome Back!"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#29213D"
                Margin="0,25,0,0"/>

            <Label
                Text="Login to continue"
                FontSize="14"
                TextColor="#888888"/>

            <!-- Username -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Username / Email"
                       TextColor="#333333"
                       FontAttributes="Bold"/>

                <Border
                    BackgroundColor="White"
                    Stroke="#DDDAE5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12">

                    <Entry
                        x:Name="UsernameEntry"
                        Placeholder="Enter username or email"
                        Keyboard="Email"
                        TextColor="#333333"
                        PlaceholderColor="#AAAAAA"/>
                </Border>
            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Password"
                       TextColor="#333333"
                       FontAttributes="Bold"/>

                <Border
                    BackgroundColor="White"
                    Stroke="#DDDAE5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12">

                    <Entry
                        x:Name="PasswordEntry"
                        Placeholder="Enter password"
                        IsPassword="True"
                        TextColor="#333333"
                        PlaceholderColor="#AAAAAA"/>
                </Border>
            </VerticalStackLayout>

            <Label
                Text="Forgot Password?"
                TextColor="#7045C5"
                HorizontalOptions="End"
                FontSize="13">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnForgotPasswordClicked"/>
                </Label.GestureRecognizers>
            </Label>

            <!-- Login Button -->
            <Button
                Text="LOGIN"
                BackgroundColor="#7045C5"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="52"
                FontAttributes="Bold"
                Clicked="OnLoginClicked"/>

            <!-- Separator -->
            <HorizontalStackLayout
                Spacing="12"
                VerticalOptions="Center">

                <BoxView HeightRequest="1"
                         BackgroundColor="#DDDAE5"
                         HorizontalOptions="FillAndExpand"/>

                <Label Text="OR"
                       TextColor="#999999"
                       FontSize="12"/>

                <BoxView HeightRequest="1"
                         BackgroundColor="#DDDAE5"
                         HorizontalOptions="FillAndExpand"/>
            </HorizontalStackLayout>

            <!-- Google Login -->
            <Button
                Text="Continue with Google"
                BackgroundColor="White"
                TextColor="#333333"
                BorderColor="#DDDAE5"
                BorderWidth="1"
                CornerRadius="10"
                HeightRequest="52"
                Clicked="OnGoogleLoginClicked"/>

            <Label
                Text="ArtClass | Learn • Create • Inspire"
                TextColor="#AAAAAA"
                FontSize="11"
                HorizontalOptions="Center"
                Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
